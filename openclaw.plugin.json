{
  "id": "trend-monitor",
  "name": "Trend Monitor",
  "description": "追踪关键词热度、监控竞争对手、发现行业机会",
  "version": "1.0.2",
  "author": "zsc-glitch",
  "homepage": "https://github.com/zsc-glitch/trend-monitor",
  "configSchema": {
    "type": "object",
    "properties": {
      "dataDir": {
        "type": "string",
        "description": "数据存储目录",
        "default": "~/.trend-monitor"
      },
      "refreshInterval": {
        "type": "number",
        "description": "自动刷新间隔（分钟）",
        "default": 360
      }
    },
    "additionalProperties": false
  }
}